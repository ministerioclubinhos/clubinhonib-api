@startuml Database Schema Map - Clubinho NIB API
!theme plain
left to right direction
skinparam componentStyle rectangle

title MySQL — schema map (32 TypeORM entities)

frame "MySQL" {
  rectangle "Core identity — 8\nusers\npersonal_data · user_preferences\nteacher_profiles · coordinator_profiles\nemail_verification_tokens\npassword_reset_tokens · feature_flags" as Core

  rectangle "Clubs and attendance — 9\naddresses · clubs · children · pagelas\naccepted_christs · club_control_logs\nacademic_periods · weekday_exceptions\nevents" as Clubs

  rectangle "Content — 8\ncomments · contacts · site_feedbacks\ndocuments · informatives\nmeditations · meditation_days · routes" as Content

  rectangle "Pages and media — 7\nideas_pages · ideas_sections\nimage_pages · image_sections\nvideos_pages · week_material_pages\nmedia_items" as Pages
}

cloud "AWS S3\nobjects referenced by media_items.url" as S3

Core --> Clubs : staff and user relations
Content --> Pages : routes and media ownership
Clubs ..> Pages : event media target (no FK)
Pages --> S3 : isLocalFile=true

legend bottom
  Detailed diagrams show keys, cardinalities and delete behavior.
  Dashed relation = polymorphic targetId/targetType, without a foreign key.
endlegend

@enduml
