@startuml Storage Providers - Clubinho NIB API
!theme plain
left to right direction
skinparam componentStyle rectangle

title Backend — persistence and external providers

rectangle "NestJS API" {
  [Feature services] as Features
  [MediaItemProcessor] as Media
  [Log storage ports] as Logs
  [EmailService] as Email
}

database "MySQL\nbusiness data, routes,\nmedia metadata" as MySQL
cloud "AWS S3\nuploaded objects" as S3
database "AWS DynamoDB\nproduction logs" as DynamoDB
folder "Protected JSONL\nlocal logs" as Files
cloud "SMTP provider" as SMTP

Features --> MySQL : repositories / transactions
Features --> Media : media operations
Media --> MySQL : metadata
Media --> S3 : upload / delete
Logs --> DynamoDB : staging / production
Logs --> Files : local development
Email --> SMTP : gated delivery

@enduml
