# Ambiente. Define o prefixo das chaves no S3 e o site padrão dos links de
# e-mail quando SITE_BASE_URL não é informado.
ENVIRONMENT=production

# Porta HTTP da aplicação.
PORT=3000

# Base dos links enviados por e-mail (recuperação de senha, confirmação,
# avisos). Tem prioridade sobre o mapa por ENVIRONMENT.
SITE_BASE_URL=https://clubinhonib.com

# --- Banco de dados (MySQL) ---
DB_HOST=prod-db.amazonaws.com
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=sua-senha
DB_NAME=clubinho

# --- AWS S3 ---
# Só o bucket é lido pela aplicação. As credenciais abaixo são resolvidas pelo
# próprio SDK a partir do ambiente; em produção o container usa a IAM Task Role
# e elas não devem existir.
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=clubinho-nib
AWS_ACCESS_KEY_ID=sua-access-key
AWS_SECRET_ACCESS_KEY=sua-secret-key

# --- JWT ---
JWT_SECRET=troque-por-um-segredo-forte
JWT_EXPIRES_IN=1h
JWT_REFRESH_SECRET=troque-por-outro-segredo-forte
JWT_REFRESH_EXPIRES_IN=7d

# --- E-mail (SMTP do Gmail) ---
# SMTP_PASSWORD é uma Senha de App do Google; a senha da conta não funciona
# com verificação em duas etapas.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=conta@gmail.com
SMTP_PASSWORD=senha-de-app-de-16-digitos
# O Gmail reescreve o remetente que não for a conta autenticada ou um alias
# verificado nela.
MAIL_FROM_NAME=Clubinhos NIB
MAIL_FROM_ADDRESS=conta@gmail.com

# --- Google OAuth ---
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# --- Twilio (WhatsApp) ---
TWILIO_ACCOUNT_SID=seu-account-sid
TWILIO_AUTH_TOKEN=seu-auth-token
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=whatsapp:+5511999999999

# --- Feed do site ---
# Página de imagens usada como feed do Clubinho.
FEED_CLUBINHO_PAGE_ID=uuid-da-pagina

# Assina o link de descadastro que vai no rodapé de todo e-mail. Separado do
# segredo de sessão para que o token não valha como credencial de acesso; sem
# esta variável, cai em JWT_SECRET. Trocá-la invalida os links já enviados.
EMAIL_UNSUBSCRIBE_SECRET=troque-por-um-segredo-longo-e-aleatorio

# O schema é alterado por migration gerada pelo CLI do TypeORM. Ligar isto faz
# o ORM alterar tabelas sozinho na subida; use só em banco descartável.
DB_SYNCHRONIZE=false

# --- Agendador ---
# Liga os jobs agendados NESTA instância. Ausente ou qualquer valor fora de
# `true`/`1` mantém tudo registrado e parado.
#
# O agendador roda dentro do processo da API: cada réplica que sobe com isto
# ligado dispara os mesmos horários por conta própria, e todo aviso sai
# repetido. Enquanto não houver trava distribuída, ligue em uma instância só.
SCHEDULER_ENABLED=false

# ── 9. OBSERVABILIDADE & TECHNICAL LOGS ───────────────────────────────────────
# Destino de logs técnicos: "file" (JSONL local) | "dynamodb" (Tabela DynamoDB)
# Em staging/produção o container não tem volume persistente: "file" explícito
# é recusado na subida. Use "dynamodb" e informe a tabela abaixo.
OBS_STORAGE=dynamodb
OBS_TTL_DAYS=30

# ── 10. AUDITORIA & COMPLIANCE ────────────────────────────────────────────────
# Destino do log de auditoria de usuário: "file" | "dynamodb"
AUDIT_STORAGE=dynamodb
AUDIT_TTL_DAYS=365
# Janela de desduplicação em segundos; 0 desativa (padrão 60).
AUDIT_DEDUP_SECONDS=60

# Tabela DynamoDB compartilhada pelos dois fluxos (uma por ambiente). A região
# vem de AWS_REGION e as credenciais da IAM Task Role.
LOG_DYNAMODB_TABLE_NAME=clubinho-nib-logs-prod
# Somente para DynamoDB Local em desenvolvimento; deixe vazio em produção.
# LOG_DYNAMODB_ENDPOINT=http://localhost:8000
